[Events API]
# Events API configuration
url = https://eventsapi.chaturbate.com/events/yourusername/your-token/
max_requests_per_minute = 1000

[OpenAI]
# OpenAI API configuration for song extraction
api_key = your-openai-api-key
model = gpt-6-luna

[Spotify]
# Spotify API credentials (PKCE; no client_secret required)
client_id = your-spotify-client-id
redirect_url = http://127.0.0.1:8888/callback
playback_device_id =

[Search]
google_api_key =
google_cx =

[Music]
source = spotify

[General]
# General application settings
song_cost = 27
multi_request_tips = true
allow_source_override_in_request_message = true
skip_song_cost = 51
request_overlay_duration = 10
request_history_size = 1000
debug_log_to_file = false
debug_log_path =

[OBS]
# OBS WebSocket configuration
enabled = true
host = 127.0.0.1
port = 4455
password =

[Web]
host = 127.0.0.1
port = 8765

[Overlay]
# One transparent Browser Source, served by TipTune. Existing configs without
# this section retain legacy text display (or Off when OBS was disabled).
mode = browser
layout = full
position = bottom-left
scale = 100
margin = 32
queue_length = 3
show_now_playing = true
show_queue = true
show_alerts = true
show_artwork = true
accent_color = #5b8cff
background_color = #111318
text_color = #f2f3f5
opacity = 90
motion = subtle
source_name = TipTune Overlay
