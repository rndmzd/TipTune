{
  "name": "tiptune-tauri",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "version:bump-minor": "node ./scripts/bump-minor.mjs",
    "webui:dev": "vite --config webui/vite.config.ts webui",
    "webui:build": "tsc -p webui/tsconfig.json && vite build --config webui/vite.config.ts webui",
    "webui:preview": "vite preview --config webui/vite.config.ts webui",
    "webui:test": "npm run webui:build && playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-shell": "2.4.1",
    "@tauri-apps/plugin-updater": "2.13.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.22.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
