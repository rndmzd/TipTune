<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <!-- upload-artifact wraps each individual file in a ZIP. Never sign upstream
       media tools or arbitrary files with the TipTune subscription. -->
  <zip-file>
    <pe-file path="*.exe" min-matches="0" max-matches="1"
             product-name="TipTune" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
    <msi-file path="TipTune_${version}_x64_en-US.msi" min-matches="0" max-matches="1">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
